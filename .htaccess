# ==== Segurança no Apache (XAMPP e hospedagens) ====
# Sem listagem de pastas
Options -Indexes

# Arquivos ocultos (.env, .git, .htaccess) e sensíveis nunca são servidos
<FilesMatch "(^\.|\.(sql|md|ini|log|lock|bak|sh|example|config)$|^composer\.(json|lock)$|^router\.php$|^security-headers\.php$)">
    Require all denied
</FilesMatch>

# Raiz do site: se o rewrite abaixo não estiver disponível, index.php entrega a página inicial
DirectoryIndex index.php

# ==== Endereços limpos ====
#   /          → public/home.html        /entrar    → public/login.html
#   /mapa      → public/index.html       /cadastro  → public/register.html
#   /perfil    → public/perfil.html      /admin     → public/admin.html
# Endereços antigos (/public/home.html, /login.html…) são redirecionados (301) para os novos.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # BASE = pasta do site ("/" na Discloud, "/a3/" no XAMPP), para os redirecionamentos
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=BASE:%1]

    # 1) antigos → novos (só no pedido original do navegador, para não entrar em loop)
    RewriteCond %{THE_REQUEST} \s[^\s?]*/public/?[\s?]
    RewriteRule ^public/?$ %{ENV:BASE} [R=301,L]
    RewriteCond %{THE_REQUEST} \.html[\s?]
    RewriteRule ^(?:public/)?home\.html$ %{ENV:BASE} [R=301,L]
    RewriteCond %{THE_REQUEST} \.html[\s?]
    RewriteRule ^(?:public/)?index\.html$ %{ENV:BASE}mapa [R=301,L]
    RewriteCond %{THE_REQUEST} \.html[\s?]
    RewriteRule ^(?:public/)?login\.html$ %{ENV:BASE}entrar [R=301,L]
    RewriteCond %{THE_REQUEST} \.html[\s?]
    RewriteRule ^(?:public/)?register\.html$ %{ENV:BASE}cadastro [R=301,L]
    RewriteCond %{THE_REQUEST} \.html[\s?]
    RewriteRule ^(?:public/)?(perfil|admin)\.html$ %{ENV:BASE}$1 [R=301,L]

    # /mapa/ → /mapa (com a barra no fim, os caminhos relativos da página quebrariam)
    RewriteRule ^(mapa|entrar|cadastro|perfil|admin)/$ %{ENV:BASE}$1 [R=301,L]

    # 2) novos → arquivo de verdade (interno: o endereço na barra não muda)
    RewriteRule ^$ public/home.html [L]
    RewriteRule ^mapa$ public/index.html [L]
    RewriteRule ^entrar$ public/login.html [L]
    RewriteRule ^cadastro$ public/register.html [L]
    RewriteRule ^(perfil|admin)$ public/$1.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # CSP estrita por padrão; páginas com Google Maps recebem a lista de domínios do Google
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self' https://viacep.com.br; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    <FilesMatch "^(index|home)\.html$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googleapis.com https://*.gstatic.com *.google.com https://*.ggpht.com *.googleusercontent.com blob:; img-src 'self' data: https://*.googleapis.com https://*.gstatic.com *.google.com *.googleusercontent.com; connect-src 'self' https://*.googleapis.com *.google.com https://*.gstatic.com https://nominatim.openstreetmap.org data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; frame-src *.google.com; worker-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    </FilesMatch>

    # HSTS só quando o site estiver em HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# (Opcional, produção) forçar HTTPS
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
