# Copie para .env (fica fora do Git) e ajuste. Valores aqui sobrescrevem config/config.php.
APP_ENV=development        # production em servidor real
APP_DEBUG=false            # nunca true em produção

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ocorrencias_ambientais
DB_USER=root               # em produção: app_ocorrencias (database/usuario_app.sql)
DB_PASSWORD=

# Discloud (ou outro provedor): cole a URL da "Conexão privada" do painel do banco.
# Se preenchida, substitui as variáveis DB_* acima.
# DB_URL=mysql://usuario:senha@host:porta/banco

# true SOMENTE atrás de proxy (Discloud). Faz o PHP enxergar HTTPS e o IP real.
TRUST_PROXY=false

SESSION_HOURS=8            # duração máxima da sessão
SESSION_IDLE_MINUTES=120   # sem uso por esse tempo, a sessão expira
